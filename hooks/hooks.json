{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/relay.py\" start"}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/relay.py\" permission", "timeout": 3600}]}],
    "PreToolUse": [{"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/relay.py\" question", "timeout": 3600}]}],
    "Notification": [{"matcher": "idle_prompt", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/relay.py\" notify"}]}]
  }
}
